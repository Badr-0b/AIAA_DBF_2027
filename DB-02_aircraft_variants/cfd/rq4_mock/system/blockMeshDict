FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Half-model box, y >= 0, sized in spans by prep_geometry.py (constant/geometry/reference).
#include "$FOAM_CASE/constant/geometry/reference"

vertices
(
    ($xMin 0     $zMin)
    ($xMax 0     $zMin)
    ($xMax $yMax $zMin)
    ($xMin $yMax $zMin)
    ($xMin 0     $zMax)
    ($xMax 0     $zMax)
    ($xMax $yMax $zMax)
    ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

boundary
(
    farfield    // inlet, outlet, top, bottom and side: freestream conditions switch in/out by flux
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (2 6 5 1)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
    midPlane    // y = 0 (not "symmetry": setConstraintTypes would match that name with the wrong type)
    {
        type symmetryPlane;
        faces
        (
            (1 5 4 0)
        );
    }
);

