FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"
#include "$FOAM_CASE/system/alphaState"

dimensions      [turbulentKineticEnergy];

internalField   uniform $kInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }

    aircraft
    {
        type            fixedValue;     // resolved wall, y+ ~ 1
        value           uniform 0;
    }
}

