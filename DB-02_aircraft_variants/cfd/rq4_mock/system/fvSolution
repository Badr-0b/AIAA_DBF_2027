FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
    }
    Phi
    {
        $p;
        relTol          0;
    }
    "(U|k|omega|gammaInt|ReThetat)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        maxIter         10;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

// SIMPLEC (consistent) takes high factors: the OpenFOAM 14 kOmegaSSTLM tutorial (T3A) uses 0.9
// throughout; 0.8 on the turbulence and transition equations leaves a margin for the 3D body.
// (Raised from 0.7 / 0.5 on 24 Oct to cut the iteration count; at 11 s per iteration it sets the sweep length.)
relaxationFactors
{
    equations
    {
        U                   0.9;
        "(k|omega)"         0.8;
        "(gammaInt|ReThetat)" 0.8;
    }
}

cache
{
    grad(U);
}

