FoamFile
{
    format      ascii;
    class       volScalarField;
    object      ReThetat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"
#include "$FOAM_CASE/system/alphaState"

dimensions      [];

internalField   uniform $ReThetatInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            inletOutlet;
        inletValue      uniform $ReThetatInf;
        value           uniform $ReThetatInf;
    }

    aircraft
    {
        type            zeroGradient;
    }
}

