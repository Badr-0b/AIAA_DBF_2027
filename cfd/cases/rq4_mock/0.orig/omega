FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"
#include "$FOAM_CASE/system/alphaState"

dimensions      [turbulentOmega];

internalField   uniform $omegaInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            inletOutlet;
        inletValue      uniform $omegaInf;
        value           uniform $omegaInf;
    }

    aircraft
    {
        type            omegaWallFunction;  // gives the viscous-sublayer value at y+ < 1
        value           uniform $omegaInf;
    }
}

